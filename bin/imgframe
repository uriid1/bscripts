#!/usr/bin/env bash

# Const
readonly version="1.1"

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/arg.sh"
source "${LIB_DIR}/fs.sh"

print_help() {
  local sname=$(echo "$0" | sed 's/.*\///')

cat <<EOF
By: uriid1
  Version: $version
  This script resizes an image and adds a frame to it.

Usage:
  $sname [OPTIONS]

Options:
  --frame, -f, -F     Set the frame size (default: 32)
  --width, -w, -W     Set the output width (default: 1024)
  --height, -h, -H    Set the output height (default: 1024)
  --image, -i, -I     Specify the input image file (required)
  --output, -o, -O    Specify the output file name (default: "output")

Example:
  $sname -i input.jpg -w 800 -h 600 -f 20 -o output.png
EOF
}

if [ $# -eq 0 ]; then
  print_help
  exit $EXIT_FAILURE
fi

case "$1" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

# $1 - path/to/image
# $2 - width
# $3 - height
# $4 - frame
# $5 - output name
convert_image() {
  local file=$1
  local width=$2
  local height=$3
  local frame=$4
  local output="$5.${file: -3}"

  if [[ -z "$output" ]]; then
    output_name="$output_name_$file"
  else
    output_name=$output
  fi

  # Get Width and Height
  local pw
  local ph
  read pw ph < <(convert "$file" -format "%w %h" info:)

  # Aspect ratio
  local ratio=$(bc -l <<< "$pw/$ph")

  local new_width
  local new_height
  if [ $pw -gt $ph ];
  then
    # New height relative to new width
    new_width=$((width - frame))
    new_height=$(bc -l <<< "$new_width/$ratio")
  else
    # New width relative to new height
    new_height=$((height - frame))
    new_width=$(bc -l <<< "$new_height*$ratio")
  fi

  # Pos in the center
  local PX=$(bc -l <<< "($width-$new_width)/2")
  local PY=$(bc -l <<< "($height-$new_height)/2")

  convert -size $width"x"$height xc:white \
    -draw "image over $PX,$PY $new_width,$new_height \"$file\"" $output_name

  echo "Finished: $output_name"
}

arg::spec value --frame -f -F
arg::spec value --width -w -W
arg::spec value --height -h -H
arg::spec value --image -i -I
arg::spec value --output -o -O

arg::parse "$@"

# Validate raw args to preserve the original's strict handling: unknown tokens
# are rejected (*) and value-options without an argument report "Missing
# argument". arg::parse otherwise swallows unknown --flags / dangling options.
__args=("$@")
__n=${#__args[@]}
__i=0
while [[ $__i -lt $__n ]]; do
  case "${__args[$__i]}" in
    --frame | -f | -F | --width | -w | -W | --height | -h | -H \
    | --image | -i | -I | --output | -o | -O)
      if [[ $(( __i + 1 )) -ge $__n || -z "${__args[$(( __i + 1 ))]}" ]]; then
        echo "Missing argument for ${__args[$__i]} option"
        exit $EXIT_FAILURE
      fi
      __i=$(( __i + 2 ))
    ;;
    --help | -help)
      __i=$(( __i + 1 ))
    ;;
    *)
      echo "Invalid argument: ${__args[$__i]}"
      exit $EXIT_FAILURE
    ;;
  esac
done

frame=$(arg::get --frame 32)
width=$(arg::get --width 1024)
height=$(arg::get --height 1024)
image=$(arg::get --image nil)
output_name=$(arg::get --output output)

if ! fs::exists "$image"; then
  echo "Error. \"$image\" is not exists"
  exit $EXIT_SUCCESS
fi

echo "Width: $width | Height $height | Frame $frame"
convert_image "$image" "$width" "$height" "$frame" "$output_name"
