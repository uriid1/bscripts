#!/usr/bin/env bash
#
# By: uriid1
# Blocking IP addresses of domains using iptables.

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/arg.sh"
source "${LIB_DIR}/net.sh"
source "${LIB_DIR}/string.sh"
source "${LIB_DIR}/log.sh"

readonly version="1.0"

print_help() {
  local sname=$(echo "$0" | sed 's/.*\///')

cat <<EOF
By: uriid1
  Version: $version
  Blocking IP addresses of domains using iptables.

Usage:
  $sname [OPTIONS]

Options:
  --domains, -d    List of domains
  --chains, -с     List of chains
  --interface, -i  Interface (Default: found first en*)

Example:
  $sname --domains site-one.com site-two.com --interface enp7s0 --chains FORWARD OUTPUT INPUT
EOF
}

if [ $# -eq 0 ]; then
  print_help
  exit $EXIT_FAILURE
fi

case "$1" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

arg::spec list --domains -d
arg::spec list --chains -c
arg::spec value --interface -i
arg::parse "$@"

__default_interface=$(ip -j link show | jq -r '.[] | select(.ifname | test("^en")) | .ifname')
__interface=$(arg::get --interface "$__default_interface")

mapfile -t __domains < <(arg::list --domains)
mapfile -t __chains < <(arg::list --chains)

sudo -v
for domain in "${__domains[@]}"; do
  IPS=$(dig +short $domain)
  for IP in $IPS; do
    if net::is_ip "$IP"; then
      for chain in "${__chains[@]}"; do
        log::info "Blocked: domain: $domain Ip: $IP Chain: $chain"
        case "$(string::lower "$chain")" in
          forward)
            sudo iptables -A FORWARD -i $__interface -d $IP -j REJECT
          ;;
          output)
            sudo iptables -A OUTPUT -o $__interface -d $IP -j REJECT
          ;;
          input)
            sudo iptables -A INPUT -i $__interface -s $IP -j REJECT
          ;;
        esac
      done
    fi
  done
done
sudo -k
