#!/usr/bin/env bash
#
# By: uriid1
#   Recursive copying of files to your Android device via ADB.

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/arg.sh"
source "${LIB_DIR}/fs.sh"

print_help() {
  local sname
  sname=$(fs::basename "$0")

cat <<EOF
By: uriid1
  Recursive copying of files to your Android device via ADB.

Options:
  --root  enable root and remount

Example:
  $sname --root path/to/ /android/path/to/
EOF
}

if [ $# -eq 0 ]; then
  print_help
  exit $EXIT_SUCCESS
fi

case "$1" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

arg::spec flag --root -r
arg::parse "$@"

mapfile -t __paths < <(arg::rest)
path="${__paths[0]}"
path_to="${__paths[1]}"

if arg::has --root; then
  adb root
  adb remount
fi

push() {
  local path=$1
  local path_to=$2

  # Создание директории, если её нет
  adb shell mkdir -p "$path_to"

  # Рекурсивный обход директории
  for file in "$path"/*; do
    if [ -d "$file" ]; then
      local dir_name=$(basename "$file")
      push "$file" "$path_to/$dir_name"
    else
      echo "Copying $file to $path_to"
      adb push "$file" "$path_to"
    fi
  done
}

push "$path" "$path_to"
