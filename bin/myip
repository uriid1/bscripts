#!/usr/bin/env bash
#
# By: uriid1
#   Show your local ethernet ip or pulic ip.

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/arg.sh"
source "${LIB_DIR}/net.sh"

print_help() {
  local sname=$(echo "$0" | sed 's/.*\///')

cat <<EOF
By: uriid1
  Show your local ethernet ip or pulic ip.

Options:
  --public, -p  Your public ip
  --all, -a     Public and local ips

Example:
  $sname           # Show local IPs
  $sname -p        # Show public IP
  $sname -a        # Show all IPs
EOF
}

case "${1:-}" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

show_local_ethernet_ip() {
  echo -e \
       "- - - - - - - - - " \
       "\nHost IP addresses" \
       "\n- - - - - - - - - "

  ip -o -4 addr show | awk '{print $2": "$4}' | cut -d/ -f1
}

show_public_ip() {
  local ip=$(net::http_get "https://ipinfo.io/ip")
  echo "${ip}"
}

arg::spec flag --public -p
arg::spec flag --all -a
arg::parse "$@"

if arg::has --public; then
  show_public_ip
elif arg::has --all; then
  show_local_ethernet_ip
  show_public_ip
elif [[ $# -eq 0 ]]; then
  show_local_ethernet_ip
else
  echo "Error: Unknown option '$1'" >&2
  echo "Use --help for usage information" >&2
  exit 1
fi
