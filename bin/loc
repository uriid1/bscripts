#!/usr/bin/env bash

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/arg.sh"
source "${LIB_DIR}/fs.sh"

print_help() {
  local sname=$(fs::basename "$0")

cat <<EOF
By: uriid1
  Counts the number of files, lines, and characters in the files of the specified directory.

Options:
  --formats, -f   Formats like: lua js sh

Example:
  $sname --dir /home/user/js/ -formats js json
EOF
}

if [ $# -eq 0 ]; then
  print_help
  exit $EXIT_FAILURE
fi

case "$1" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

arg::spec list --formats -f
arg::spec value --dir -d
arg::parse "$@"

mapfile -t FORMATS < <(arg::list --formats)
DIR=$(arg::get --dir "$PWD")

files=0
lines=0

find_expr=""
for format in "${FORMATS[@]}"; do
  find_expr+=" -name '*.${format}' -o"
done
find_expr=${find_expr::-3}

for file in $(eval "find "${DIR}" -type f \( ${find_expr} \) -not -path '*/\.*'"); do
  files=$((files + 1))
  lines=$((lines + $(wc -l < "$file")))
done

echo "Files: ${files}"
echo "Lines: ${lines}"
