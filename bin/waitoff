#!/usr/bin/env bash
#
# By: uriid1
#   Shutdown automatically when process completes.

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/proc.sh"

print_help() {
  local sname=$(echo "$0" | sed 's/.*\///')

cat <<EOF
By: uriid1
  Shutdown automatically when process completes.

Example:
  $sname ffmpeg
  Or with pid
  $sname 12345
EOF
}

if [ $# -eq 0 ]; then
  print_help
  exit $EXIT_FAILURE
fi

case "$1" in
  --help | -h)
    print_help
    exit $EXIT_SUCCESS
  ;;
esac

arg=$1
if ! [[ "$arg" =~ ^[0-9]+$ ]]; then
  PID=$(pgrep $arg)
else
  PID=$arg
fi

echo "[$PID]: Wait $(ps -p "$PID" -o comm=) to stop..."
while proc::is_running "$PID"; do
  sleep 10
done

shutdown -h now
