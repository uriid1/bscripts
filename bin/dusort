#!/usr/bin/env bash
#
# By: uriid1
#   Space of used files.

__BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${__BIN_DIR}/../lib"
if [[ ! -f "${LIB_DIR}/const.sh" ]]; then
  echo "Error: bash-libs not found at ${LIB_DIR}. Run: git submodule update --init" >&2
  exit 1
fi

source "${LIB_DIR}/const.sh"
source "${LIB_DIR}/fs.sh"

print_help() {
  local sname
  sname=$(fs::basename "$0")

cat <<EOF
By: uriid1
  Space of used files.

Example:
  $sname /home/$USER/*
EOF
}

case "$1" in
  --help | -h)
    print_help
    exit "$EXIT_SUCCESS"
  ;;
esac

echo -e "-----\t-------"
echo -e "Usage\tFile(s)"
echo -e "-----\t-------"
mapfile -t du_output < <(du -sh -c "$@" 2>/dev/null | sort -hr)
echo -e "${du_output[0]}"
echo -e "-----\t-------"

for entry in "${du_output[@]:1}"; do
  printf "${entry}"
  printf "\n"
done
